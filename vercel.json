{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "rewrites": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.labrecord.cloud"
        }
      ],
      "destination": "/main/$1"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "labrecord.cloud"
        }
      ],
      "destination": "/main/$1"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "tools.labrecord.cloud"
        }
      ],
      "destination": "/tools/$1"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "finance.labrecord.cloud"
        }
      ],
      "destination": "/finance/$1"
    }
  ]
}