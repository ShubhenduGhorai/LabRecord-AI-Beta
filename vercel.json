{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "redirects": [
    {
      "source": "/loan-calculator.html",
      "destination": "/loan-calculator",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "finance.labrecord.cloud"
        }
      ]
    }
  ],

  "rewrites": [
    {
      "source": "/loan-calculator",
      "destination": "/finance/loan-calculator.html",
      "has": [
        {
          "type": "host",
          "value": "finance.labrecord.cloud"
        }
      ]
    },

    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.labrecord.cloud"
        }
      ],
      "destination": "/main/$1"
    },

    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "labrecord.cloud"
        }
      ],
      "destination": "/main/$1"
    },

    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "tools.labrecord.cloud"
        }
      ],
      "destination": "/tools/$1"
    },

    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "finance.labrecord.cloud"
        }
      ],
      "destination": "/finance/$1"
    }
  ]
}